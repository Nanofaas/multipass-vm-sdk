# Normalize line endings. This SDK drives a Linux daemon from wherever the
# caller happens to be, so a CRLF leaked in from a Windows editor breaks things
# in ways that are hard to spot in review.
* text=auto eol=lf

*.py    text diff=python
*.toml  text
*.yml   text
*.yaml  text
*.json  text
*.md    text diff=markdown
*.txt   text
*.ini   text
*.cfg   text

# Binary assets: never normalize, never try to diff.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.whl   binary
*.gz    binary
*.zip   binary

# Generated at runtime.
.coverage       linguist-generated=true
coverage.xml    linguist-generated=true
uv.lock         linguist-generated=true -diff
